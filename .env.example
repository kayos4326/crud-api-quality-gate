# Copy to .env and fill in. NEVER commit the real .env.
PORT=3000

# Prisma connection string
DATABASE_URL="mysql://USER:PASSWORD@YOUR_VM_FQDN:3306/store"

# Signing key for JWTs. Generate a long random value; never reuse across environments.
JWT_SECRET=replace-with-a-long-random-value

# Redis distributed cache (Week 10)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Azure Key Vault identity (Week 9)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
